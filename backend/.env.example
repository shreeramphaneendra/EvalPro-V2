PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/evalpro_v2
JWT_SECRET=change_this_to_a_random_secret_string

# ── Cloudinary (file storage for assignment submissions) ──────────────────────
# Create free account at cloudinary.com → Dashboard → copy these 3 values
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ── First-time setup secret ───────────────────────────────────────────────────
# This secret is required when creating the first admin through the browser setup page.
# Change this to something only you know before deploying.
# After first admin is created, this has no effect (bootstrap is permanently locked).
BOOTSTRAP_SECRET=change_this_before_deploying

# ── Google Gemini AI (optional, free tier: 15 req/min, 1500 req/day) ──────────
# Get your free API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
